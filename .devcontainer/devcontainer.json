{
  "name": "NEX Forgejo (GitHub Codespaces)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "NEX Forgejo",
      "onAutoForward": "notify",
      "protocol": "https"
    }
  },
  "postStartCommand": "docker compose -f deploy/forgejo/docker-compose.codespaces.yml up -d"
}
