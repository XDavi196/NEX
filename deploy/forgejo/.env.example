# Replace with a real domain that you own and point its DNS A/AAAA record to your server.
FORGEJO_DOMAIN=git.example.com
ACME_EMAIL=admin@example.com

# The Forgejo account that will own the mirrored NEX repository.
FORGEJO_OWNER=XDavi196
FORGEJO_REPO=NEX

# Public SSH port for Git clone/push. Keep 2222 unless it is already used.
FORGEJO_SSH_PORT=2222

# Create this token inside Forgejo after the first admin login.
# Keep this value secret. Never commit the real .env file.
FORGEJO_TOKEN=

# Only copy APK/AAB/etc. assets for the newest 8 releases to limit disk usage.
# All release notes/tags are mirrored; raise this number if you want more binaries.
SYNC_ASSET_RELEASES=8
SYNC_INTERVAL_SECONDS=1800
